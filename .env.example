# =============================================================================
# Automatic School Bus Attendance System - Configuration
# =============================================================================

# Supabase Project Configuration
# Found in: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-or-publishable-key-here

# Bus & Hardware Device Configuration
DEFAULT_BUS_ID=Bus01
DEVICE_ID=BUS01_DEV_01

# Synchronization Settings
SYNC_ENABLED=false
SYNC_INTERVAL_SECONDS=20
SYNC_BATCH_SIZE=50
SYNC_MAX_RETRIES=5

# Local SQLite Database Path (Defaults to data/attendance.db)
DATABASE_PATH=data/attendance.db
